generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  nickname      String
  birthDate     DateTime
  birthHour     Int?
  birthMinute   Int?
  birthPlace    String?
  gender        String?
  avatarUrl     String?
  zodiac        String?
  constellation String?
  chineseZodiac String?
  email         String?  @unique
  passwordHash  String?
  authProvider  String   @default("legacy")
  authProviderId String?
  role          String   @default("user")
  isDeleted     Boolean  @default(false)
  deletedAt     DateTime?
  totalReadings        Int      @default(0)
  fulfilledPredictions Int      @default(0)
  currentStreak        Int      @default(0)
  longestStreak        Int      @default(0)
  memberDays           Int      @default(0)
  emailVerified     Boolean   @default(false)
  createdAt         DateTime  @default(now())
  lastActiveAt      DateTime  @updatedAt

  archives     FateArchive[]
  dailyFortunes DailyFortune[]
  chatContexts  ChatContext[]
  fateBook     FateBook?
}

model FateArchive {
  id                String   @id @default(cuid())
  userId            String
  type              String   // tarot, dailyFortune, zodiac, etc.
  question          String
  readingResult     String   // JSON
  aiInterpretation  String
  aiAdvice          String?
  cards             String?  // JSON
  spreadName        String?
  predictionStatus  String?  @default("pending") // pending, fulfilled, unfulfilled, partially
  predictionDueDate DateTime?
  predictionNote    String?
  userRating        Int?
  userReflection    String?
  tags              String  // JSON array
  isShared          Boolean  @default(false)
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([type])
}

model DailyFortune {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime
  overallScore   Int
  categories     String   // JSON array
  generalAdvice  String
  luckyColor     String
  luckyNumber    Int
  luckyDirection String
  luckyTime      String?
  poemLine       String?
  poemInterpretation String?
  reminders      String   // JSON array
  yi             String   // JSON array - 宜做的事
  ji             String   // JSON array - 忌做的事
  divineSign     String?  // JSON - 灵签数据
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

model ChatContext {
  id        String   @id @default(cuid())
  userId    String
  messages  String   // JSON array
  contextId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([contextId])
}

model FateBook {
  id        String   @id @default(cuid())
  userId    String   @unique
  // 纯计算数据（fate-engine 输出，JSON）
  baziData  String   // 四柱/五行/十神/纳音/用神忌神
  dayunData String   // 大运排盘结果 JSON
  // AI 解读数据
  summary   String   // AI 生成的总论
  pattern   String?  // 格局名称
  personality String? // 性格画像
  dimensions String  // JSON, 四维度评价(事业/财运/感情/健康)
  dayunInterpretation String // JSON, 大运解读(当前+未来3步)
  liunian   String?  // JSON, 当前流年分析
  advice    String?  // 综合建议
  details   String?  // JSON, AI扩展内容(四柱详解/藏干/神煞解读/五行/十神/专项/关键年/流月)
  // 元数据
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}
